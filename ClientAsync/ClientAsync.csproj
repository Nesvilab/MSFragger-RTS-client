<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<Protobuf Include="..\Protos\RealTime.proto" GrpcServices="Client" Link="Protos\RealTime.proto" />

		<PackageReference Include="Google.Protobuf" Version="3.36.2" />
		<PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
		<PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="All" />
		<PackageReference Include="mzLib" Version="1.0.595" />
	</ItemGroup>

</Project>