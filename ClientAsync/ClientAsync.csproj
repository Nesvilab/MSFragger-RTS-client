<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net5.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<Protobuf Include="..\Protos\RealTime.proto" GrpcServices="Client" Link="Protos\RealTime.proto" />

		<PackageReference Include="Google.Protobuf" Version="3.19.2" />
		<PackageReference Include="Grpc.Net.Client" Version="2.41.0" />
		<PackageReference Include="Grpc.Tools" Version="2.43.0" PrivateAssets="All" />
		<PackageReference Include="mzLib" Version="1.0.508" />
	</ItemGroup>

</Project>